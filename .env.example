# Required Neon PostgreSQL connection. Use the pooled URL for application traffic.
DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# MongoDB Atlas connection used for AI screening reports.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<database>

# Google AI Studio API key used by Gemini features.
GEMINI_API_KEY=your-google-ai-studio-api-key

# Secret used to sign and verify authentication tokens. Generate a unique value.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes

# Server settings.
PORT=3000
NODE_ENV=development
ENABLE_DEMO_OTP=true
DISABLE_HMR=true
APP_URL=http://localhost:3000
